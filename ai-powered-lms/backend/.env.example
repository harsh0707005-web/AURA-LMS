PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
COOKIE_SECURE=false
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_lms
JWT_SECRET=replace-with-a-long-random-development-secret
ACCESS_TOKEN_EXPIRES_IN=15m

# Email delivery (required for real verification and password-reset links)
RESEND_API_KEY=
VERIFICATION_EMAIL_FROM=AURA LMS <no-reply@example.edu>

# AI providers
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=
GEMINI_THINKING_BUDGET=0
GEMINI_COMPLEX_THINKING_BUDGET=1024
GEMINI_REQUEST_TIMEOUT_MS=45000
GEMINI_EMBEDDING_BUDGET_MS=30000
GEMINI_GENERATION_BUDGET_MS=90000
GEMINI_COMPLEX_GENERATION_BUDGET_MS=120000
GEMINI_MAX_ATTEMPTS_PER_MODEL=1
GEMINI_MAX_TOTAL_ATTEMPTS=4
GEMINI_TUTOR_MAX_OUTPUT_TOKENS=1200
GEMINI_TUTOR_COMPLEX_MAX_OUTPUT_TOKENS=1600
DEFAULT_LLM_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_MS=30000

# Retrieval and durable AI workflow limits
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55
RAG_MAX_CONTEXT_CHARS=10000
RAG_MAX_HISTORY_CHARS=4000
AI_MESSAGE_WORKFLOW_TIMEOUT_MS=120000

# Operational backup commands (never commit backup files)
# Existing absolute private directory OUTSIDE the repository. No automatic pruning.
BACKUP_DIR=
# Required and different from S3_BUCKET_NAME when S3_ENABLED=true.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=
# Local drill inputs, set only while testing; never point at the application database.
# BACKUP_FILE=<absolute dump path; matching .sha256 sidecar required>
# STORAGE_BACKUP_DIR=<absolute materials snapshot path>
# RESTORE_DATABASE_NAME=aura_restore_test
# CONFIRM_RESTORE=YES
# CONFIRM_LOCAL_DRILL=YES

# Object storage (set S3_ENABLED=true outside local development)
S3_ENABLED=false
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_DELIVERY_MODE=proxy
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
